!/LICENSE
!/NOTICE.txt
!/README.md
!/docker/
!/eval/
!/final_evaluation/
!/frontend/
!/pyproject.toml
!/requirements.txt
!/src/

__pycache__/
*.py[cod]
*.log
/eval/out*/
