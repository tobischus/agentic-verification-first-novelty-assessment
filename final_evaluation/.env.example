# Copy to final_evaluation/.env. Local use needs only SESSION_SECRET and ACCESS_CODE_PEPPER:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
SESSION_SECRET=
ACCESS_CODE_PEPPER=

# Default: SQLite under final_evaluation/private/
DATABASE_URL=

# local | supabase
STORAGE_BACKEND=local
LOCAL_ASSET_ROOT=final_evaluation/private/assets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
