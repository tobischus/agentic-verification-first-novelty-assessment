# Copy to final_evaluation/.env and fill in. Never commit the real .env (see .gitignore).
#
# Local development needs only SESSION_SECRET and ACCESS_CODE_PEPPER -- everything else
# has a working local default (SQLite under private/, local file storage under
# private/assets/). Generate both secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
SESSION_SECRET=
ACCESS_CODE_PEPPER=

# --- Database. Local default: SQLite. Cloud: the real Supabase connection string. ---
# DATABASE_URL=sqlite:///final_evaluation/private/local_study.sqlite
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Storage. local | supabase. Cloud MUST use supabase -- Render's filesystem is not durable. ---
STORAGE_BACKEND=local
LOCAL_ASSET_ROOT=final_evaluation/private/assets

# --- Supabase Storage (only read when STORAGE_BACKEND=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Public URL of this deployment once hosted (used in a few generated messages/links) ---
PUBLIC_BASE_URL=

# --- Shown on the login page and required before APP_ENV=production will start ---
STUDY_CONTACT=

# --- Local server bind (serve command) ---
HOST=127.0.0.1
PORT=8010
